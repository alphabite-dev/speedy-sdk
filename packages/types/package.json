{
	"name": "@alphabite/speedy-types",
	"version": "1.2.0",
	"description": "TypeScript type definitions for the Speedy shipping API (Bulgaria). Used by @alphabite/speedy-sdk.",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts --clean",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"speedy",
		"types",
		"typescript",
		"shipping",
		"bulgaria",
		"logistics"
	],
	"author": "Alphabite",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/alphabite-dev/speedy-sdk.git",
		"directory": "packages/types"
	},
	"bugs": {
		"url": "https://github.com/alphabite-dev/speedy-sdk/issues"
	},
	"homepage": "https://github.com/alphabite-dev/speedy-sdk#readme",
	"devDependencies": {
		"tsup": "^8.0.1",
		"typescript": "^5.3.3"
	}
}
