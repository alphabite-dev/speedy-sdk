{
  "name": "@alphabite/speedy-sdk",
  "version": "1.1.0",
  "description": "Unofficial TypeScript SDK for the Speedy shipping API (Bulgaria). Promise-based, fully typed, dual CJS/ESM.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "speedy",
    "shipping",
    "courier",
    "bulgaria",
    "sdk",
    "api",
    "typescript",
    "delivery",
    "logistics",
    "tracking",
    "shipment"
  ],
  "author": "Alphabite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphabite-dev/speedy-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alphabite-dev/speedy-sdk/issues"
  },
  "homepage": "https://github.com/alphabite-dev/speedy-sdk#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@alphabite/speedy-types": "^1.1.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@vitest/ui": "^4.0.3",
    "dotenv": "^17.2.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.3"
  }
}
