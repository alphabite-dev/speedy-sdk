{
  "name": "@alphabite/speedy",
  "version": "1.1.0",
  "description": "Workspace root for the Unofficial Speedy shipping API SDK. The publishable packages live in packages/sdk and packages/types.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:types": "npm run build -w @alphabite/speedy-types",
    "build:sdk": "npm run build -w @alphabite/speedy-sdk",
    "dev": "npm run dev -w @alphabite/speedy-sdk",
    "test": "npm run test -w @alphabite/speedy-sdk",
    "test:watch": "npm run test:watch -w @alphabite/speedy-sdk",
    "test:ui": "npm run test:ui -w @alphabite/speedy-sdk",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "speedy",
    "shipping",
    "courier",
    "bulgaria",
    "sdk",
    "api",
    "typescript",
    "delivery",
    "logistics",
    "tracking",
    "shipment"
  ],
  "author": "Alphabite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alphabite-dev/speedy-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/alphabite-dev/speedy-sdk/issues"
  },
  "homepage": "https://github.com/alphabite-dev/speedy-sdk#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
